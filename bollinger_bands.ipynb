    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"transaction_costs = 0.004\\n\",\n",
    "    \"df['Change_entry'] = np.where(df['Signal'] != df['Signal'].shift(-1),1,0)\\n\",\n",
    "    \"df['Cost'] = transaction_costs * df['Change_entry']\\n\",\n",
    "    \"df['Strat_ret_net'] = df['Strategy_returns'] - df['Cost']\\n\",\n",
    "    \"df = df.drop(columns = ['Change_entry','Cost'])\\n\",\n",
    "    \"df['Eq_curve'] = (1 + df['Strategy_returns']).cumprod()\\n\",\n",
