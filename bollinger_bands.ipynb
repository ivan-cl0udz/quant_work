    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"df['Signal'] = 0\\n\",\n",
    "    \"position = 0  # 0 = no position, 1 = in trade\\n\",\n",
    "    \"\\n\",\n",
    "    \"for i in range(len(df)):\\n\",\n",
    "    \"    if position == 0:\\n\",\n",
    "    \"        # Not in trade — check for entry\\n\",\n",
    "    \"        if df['Close'].iloc[i] < df['Lower_Band'].iloc[i]:\\n\",\n",
    "    \"            position = 1\\n\",\n",
    "    \"            df.iloc[i, df.columns.get_loc('Signal')] = 1\\n\",\n",
    "    \"    elif position == 1:\\n\",\n",
    "    \"        # In trade — stay in\\n\",\n",
    "    \"        df.iloc[i, df.columns.get_loc('Signal')] = 1\\n\",\n",
    "    \"        # Check for exit\\n\",\n",
    "    \"        if df['Close'].iloc[i] >= df['SMA'].iloc[i]:\\n\",\n",
    "    \"            position = 0\\n\",\n",
    "    \"            df.iloc[i, df.columns.get_loc('Signal')] = 0\"\n",
    "   ],\n",
    "   \"id\": \"cf4e7251eae430e6\",\n",
