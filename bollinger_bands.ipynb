    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"df['Signal'] = df['Signal'].shift(1)\\n\",\n",
    "    \"df['Returns'] = df['Close'].pct_change()\\n\",\n",
    "    \"df.dropna(inplace = True)\"\n",
